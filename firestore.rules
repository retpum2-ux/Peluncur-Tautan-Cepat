rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    match /test/{docId} {
      allow read: if true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidAppSpace(data) {
      return data.keys().hasAll(['groups']) &&
             data.keys().hasOnly(['groups', 'settings', 'updatedAt', 'createdAt']) &&
             data.groups is list &&
             data.groups.size() <= 100;
    }

    match /app_spaces/{spaceId} {
      allow read: if isValidId(spaceId);
      allow write: if isValidId(spaceId) && isValidAppSpace(incoming());
    }
  }
}
